        {
          "id": "9e9c74fc-544e-4872-9338-3edaa29d53ba",
          "name": "Update a custom field schema",
          "request": {
            "name": "Update a custom field schema",
            "description": {
              "content": "To reorder Custom Fields (and thus change the order in which they are displayed in the Close UI), you simply need to supply a `fields` list with `{\"id\": ...}` items corresponding to the IDs of the Custom Fields belonging to the given Schema. Note that any IDs that are omitted from the list with be automatically appended to the end of the list. If you want to remove some Fields from the Schema, then delete the Custom Field or – in case of Shared Custom Fields – disassociate the Field from the given object.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "custom_field_schema",
                ":object_type",
                ""
