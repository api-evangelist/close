              }
            ]
          },
          "docs": "Retrieve a single phone number"
        },
        {
          "info": {
            "name": "Update a phone number",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.close.com/api/v1/phone_number/:id/",
            "headers": [
              {
                "name": "Authorization",
