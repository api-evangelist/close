          "info": {
            "name": "List Send As Associations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.close.com/api/v1/send_as/",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "allowed_user_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "allowing_user_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "A user only has access to associations they are involved in. This means that when using this endpoint, `allowing_user_id` or `allowed_user_id` must be equal to your user ID. If neither filter is provided, `allowing_user_id` is assumed by default."
        },
        {
          "info": {
            "name": "Create a Send As Association",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.close.com/api/v1/send_as/",
