          "name": "List Custom Object Types",
          "request": {
            "name": "List Custom Object Types",
            "description": {
              "content": "The response will include all Custom Object Types, including Custom Field metadata for your organization.\n\nEach Custom Object Type has two lists of Custom Fields. The `fields` property contains the list of fields that belong to the Custom Object Type. The `back_reference_fields` property contains the list of any objects (Leads, Contacts, Opportunities, Custom Activities, Custom Objects) that reference the Custom Object Type.",
              "type": "text/plain"
            },
            "url": {
