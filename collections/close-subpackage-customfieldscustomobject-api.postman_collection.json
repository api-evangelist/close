        {
          "id": "2476c1d4-fd79-4c32-a515-375c622b5713",
          "name": "Delete a Custom Object Custom Field",
          "request": {
            "name": "Delete a Custom Object Custom Field",
            "description": {
              "content": "Delete a custom field from a custom object type. The field will immediately disappear from API responses and values on existing custom object instances will be permanently removed.",
